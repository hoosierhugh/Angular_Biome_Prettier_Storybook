{
  "name": "AngularBiomePrettier",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write . && prettier --write \"src/**/*.html\"",
    "format:check": "biome format . && prettier --check \"src/**/*.html\"",
    "check": "biome check --write .",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=true ng run Counter:storybook",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=true ng run Counter:build-storybook"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "storybook": "^10.6.1",
    "@storybook/angular-vite": "^10.6.1",
    "@chromatic-com/storybook": "^5.4.0",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@types/node": "^26.6.4",
    "@angular-devkit/architect": "^0.2202.1",
    "@angular-devkit/core": "^22.2.1",
    "@angular/animations": "^22.2.1",
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "vite": "^8.3.1",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "playwright": "^1.63.0"
  }
}
